# Neon Postgres (use the Pooled Connection string)
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Login Security — generate with: npm run pin
SHOP_PIN_HASH=
JWT_SECRET=change-me-to-a-random-32-char-string

# Cloudflare R2 (optional — only needed for customer photos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shop-photos
R2_PUBLIC_URL=

# Local demo mode only — set to 1 to run WITHOUT Neon (embedded Postgres + sample data)
# DEMO_DB=1
